# Backend environment — copy to backend/.env and fill in real values.
# Only variables used by the live MVP path are listed here.

# --- Backblaze B2 (asset storage, S3-compatible API) ---
# From the Backblaze B2 console: create a bucket + an application key.
B2_BUCKET_NAME=your-bucket-name
# Regional S3 endpoint shown on the bucket page, e.g. https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT_URL=https://s3.us-west-XXX.backblazeb2.com
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key

# --- Generation providers ---
# OpenAI: storyboard + image generation. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
# Luma: image-to-video. https://lumalabs.ai/dream-machine/api
LUMA_API_KEY=your-luma-key

# --- Database ---
# Docker Compose overrides this to the postgres service; for manual/local dev
# SQLite works out of the box: sqlite:///./ai_film_studio.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_film_studio

# --- Redis (generation job queue + worker; required) ---
# Docker Compose overrides this to the redis service; manual dev: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# --- Postgres (used by the Docker Compose postgres service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_film_studio

# --- Auth ---
# MUST be a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-a-long-random-string
# Access token lifetime in minutes (default 1440 = 24h).
ACCESS_TOKEN_MINUTES=1440

# --- Internal service URL (backend-to-backend base, set by Compose) ---
INTERNAL_API_BASE_URL=http://backend:8000
